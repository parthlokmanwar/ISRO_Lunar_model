# Both keys are optional. Without them the pipeline works exactly the same;
# only the Vyom assistant changes, falling back to answers built from the
# current run's own metrics instead of a language model.

# https://openrouter.ai — chat responses
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.5-flash"

# https://elevenlabs.io — optional spoken responses
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""
ELEVENLABS_MODEL_ID="eleven_flash_v2_5"

# Override only if the project lives somewhere unusual (Docker sets this).
# LCE_PROJECT_ROOT="/app"
# LCE_ALLOWED_ORIGINS="http://localhost:3000"
